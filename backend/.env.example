# PostgreSQL connection URL (e.g. postgres://user:password@host:port/database)
DATABASE_URL=postgres://admin:password123@localhost:5432/ecom_db

# HTTP server listening port
PORT=5000

# Application environment runtime mode (development, test, production)
NODE_ENV=development

# Secret key used for signing JWT access tokens (minimum 32 characters)
JWT_SECRET=example_super_secret_jwt_access_key_min_32_chars_long

# Distinct secret key used for signing JWT refresh tokens (minimum 32 characters)
JWT_REFRESH_SECRET=example_super_secret_jwt_refresh_key_min_32_chars_long

# Expiration window for access tokens (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# Expiration window for refresh token cookies (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# Allowed browser origin for CORS with credentials (e.g. http://localhost:5173 or https://app.example.com)
CORS_ORIGIN=http://localhost:5173

# Feature flag for Redis acceleration: 0 for in-memory fallback, 1 for live Redis server
REDIS_ENABLED=0

# Redis connection URL used when REDIS_ENABLED=1
REDIS_URL=redis://localhost:6379

# Number of reverse proxy / load balancer hops to trust for client IP determination (0 for direct/local, 1 for AWS ALB)
TRUST_PROXY_HOPS=0

# Google OAuth 2.0 Web Client ID for verifying ID tokens (optional in development)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
